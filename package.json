{
  "name": "daystep-v6",
  "version": "6.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:shared": "pnpm --filter @daystep/design-tokens build && pnpm --filter @daystep/domain build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @daystep/mobile --filter @daystep/dashboard dev",
    "dev:mobile": "pnpm build:shared && pnpm --filter @daystep/mobile dev",
    "dev:dashboard": "pnpm build:shared && pnpm --filter @daystep/dashboard dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
